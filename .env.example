# Copy to .env. Never commit real secrets.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cyrelle:cyrelle@localhost:5432/cyrelle
REDIS_URL=redis://localhost:6379
ENABLE_QUEUES=true

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_DAYS=30
WEBHOOK_SECRET=replace-with-a-webhook-secret
VERIFICATION_ENCRYPTION_KEY=replace-with-64-hex-characters

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8081
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

PAYMENT_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
ALLOW_DEV_GOOGLE=true

SMTP_URL=
EMAIL_FROM=Cyrelle <no-reply@cyrelle.app>

AI_PROVIDER=cyrelle-local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

VERIFICATION_PROVIDER=sumsub
# Sumsub sandbox credentials. Leave blank to run Cyrelle without calling Sumsub.
# Sandbox and production use https://api.sumsub.com. The app token selects the environment.
SUMSUB_ENVIRONMENT=sandbox
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_TOKEN_TTL_SECS=600
IDENTITY_VERIFICATION_MAX_RETRIES=3

S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=
UPLOAD_DIR=./uploads

LIVEKIT_URL=
FCM_SERVER_KEY=

CDN_BASE_URL=
